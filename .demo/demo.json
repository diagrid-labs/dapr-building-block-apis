{
  "$schema": "https://demotime.elio.dev/demo-time.schema.json",
  "title": "Demo",
  "description": "",
  "version": 2,
  "demos": [
    {
      "title": "Intro",
      "description": "",
      "steps": [
        {
          "action": "executeVSCodeCommand",
          "command": "workbench.action.terminal.killAll"
        },
        {
          "action": "executeVSCodeCommand",
          "command": "workbench.action.closeSidebar"
        },
        {
          "action": "openSlide",
          "path": "/.demo/slides/intro.md"
        }
      ],
      "icons": {
        "start": "vm",
        "end": "pass-filled"
      }
    },
    {
      "title": "What if",
      "description": "",
      "steps": [
        {
          "action": "openSlide",
          "path": "/.demo/slides/what-if.md"
        }
      ],
      "icons": {
        "start": "vm",
        "end": "pass-filled"
      }
    },
    {
      "title": "Demo 1: SaveState",
      "icons": {
        "start": "vm",
        "end": "pass-filled"
      },
      "steps": [
         {
          "action": "executeVSCodeCommand",
          "command": "workbench.action.focusSideBar"
        },
        {
          "action": "executeTerminalCommand",
          "command": "cd Demo1"
        },
        {
          "action": "highlight",
          "path": "/Demo1/ProfileService/Program.cs",
          "position": 14
        }
      ]
    },
    {
      "title": "Demo 1a: Run",
      "icons": {
        "start": "terminal-cmd",
        "end": "pass-filled"
      },
      "steps": [
        {
          "action": "executeTerminalCommand",
          "command": "dapr run -f ."
        },
        {
          "action": "showInfoMessage",
          "message": "Demo 1 has been started (dapr run -f .)"
        }
      ]
    },
    {
      "title": "Demo 1a: Call endpoints",
      "icons": {
        "start": "symbol-event",
        "end": "pass-filled"
      },
      "steps": [
        {
          "action": "highlight",
          "path": "/Demo1/demo1.http",
          "position": 6
        }
      ]
    },
    {
      "title": "Demo 1a: Stop",
      "icons": {
        "start": "terminal-cmd",
        "end": "pass-filled"
      },
      "steps": [
        {
          "action": "executeVSCodeCommand",
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "\u0003"
          }
        },
        {
          "action": "showInfoMessage",
          "message": "Demo 1 has been stopped (CTRL+C)"
        }
      ]
    },
    {
      "title": "Demo 1b: Switch state store",
      "icons": {
        "start": "terminal-cmd",
        "end": "pass-filled"
      },
      "steps": [
        {
          "action": "rename",
          "path": "/Demo1/Resources/statestore-redis.yaml",
          "dest": "/Demo1/Resources/statestore-redis.yaml.temp"
        },
        {
          "action": "rename",
          "path": "/Demo1/Resources/statestore-postgres.yaml.temp",
          "dest": "/Demo1/Resources/statestore-postgres.yaml"
        },
        {
          "action": "showInfoMessage",
          "message": "Switched to Postgres"
        }
      ]
    },
    {
      "title": "Demo 1b: Run",
      "icons": {
        "start": "terminal-cmd",
        "end": "pass-filled"
      },
      "steps": [
        {
          "action": "executeTerminalCommand",
          "command": "dapr run -f ."
        },
        {
          "action": "showInfoMessage",
          "message": "Demo 1 has been started (dapr run -f .)"
        }
      ]
    },
    {
      "title": "Demo 1b: Call endpoints",
      "icons": {
        "start": "symbol-event",
        "end": "pass-filled"
      },
      "steps": [
        {
          "action": "highlight",
          "path": "/Demo1/demo1.http",
          "position": 6
        }
      ]
    },
    {
      "title": "Demo 1b: Stop",
      "icons": {
        "start": "terminal-cmd",
        "end": "pass-filled"
      },
      "steps": [
        {
          "action": "executeVSCodeCommand",
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "\u0003"
          }
        },
        {
          "action": "showInfoMessage",
          "message": "Demo 1 has been stopped (CTRL+C)"
        }
      ]
    },
